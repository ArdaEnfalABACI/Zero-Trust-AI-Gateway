{
  "custom_recognizers": [
    {
      "name": "TR_NATIONAL_ID",
      "language": "tr",
      "patterns": [
        {
          "name": "tc_kimlik_pattern",
          "regex": "\\b[1-9][0-9]{10}\\b",
          "score": 0.85
        }
      ]
    },
    {
      "name": "TR_TAX_ID",
      "language": "tr",
      "patterns": [
        {
          "name": "vergi_no_pattern",
          "regex": "\\b[0-9]{10}\\b",
          "score": 0.80
        }
      ]
    },
    {
      "name": "US_SSN_CUSTOM",
      "language": "en",
      "patterns": [
        {
          "name": "us_ssn_pattern",
          "regex": "\\b\\d{3}[- ]?\\d{2}[- ]?\\d{4}\\b",
          "score": 0.90
        }
      ]
    },
    {
      "name": "UK_NINO",
      "language": "en",
      "patterns": [
        {
          "name": "uk_nino_pattern",
          "regex": "\\b[A-CEGHJ-PR-TW-Z]{1}[A-CEGHJ-NPR-TW-Z]{1}[- ]?[0-9]{2}[- ]?[0-9]{2}[- ]?[0-9]{2}[- ]?[A-DFM]{1}\\b",
          "score": 0.90
        }
      ]
    },
    {
      "name": "GLOBAL_PHONE",
      "language": "en",
      "patterns": [
        {
          "name": "intl_phone_standard",
          "regex": "\\b(?:\\+?\\d{1,3}[- ]?)?\\(?\\d{3}\\)?[- ]?\\d{3}[- ]?\\d{4}\\b",
          "score": 0.85
        },
        {
          "name": "intl_phone_flexible",
          "regex": "\\b(?:\\+?\\d{1,3}[- ]?)?(?:[\\s-]?\\d){10}\\b",
          "score": 0.75
        }
      ]
    },
    {
      "name": "GLOBAL_PHONE",
      "language": "tr",
      "patterns": [
        {
          "name": "tr_phone_standard",
          "regex": "\\b(?:\\+?90[\\s-]?)?(?:0[\\s-]?)?(?:\\(?[1-9][0-9]{2}\\)?)[\\s-]?[0-9]{3}[\\s-]?[0-9]{2}[\\s-]?[0-9]{2}\\b",
          "score": 0.85
        },
        {
          "name": "tr_phone_flexible",
          "regex": "\\b(?:0[\\s-]?)?[1-9](?:[\\s-]?[0-9]){9}\\b",
          "score": 0.80
        }
      ]
    },
    {
      "name": "IBAN_CUSTOM",
      "language": "en",
      "patterns": [
        {
          "name": "iban_pattern",
          "regex": "\\b[A-Z]{2}[0-9]{2}(?:[ ]?[0-9a-zA-Z]{4}){3,7}\\b",
          "score": 0.85
        }
      ]
    },
    {
      "name": "IBAN_CUSTOM",
      "language": "tr",
      "patterns": [
        {
          "name": "iban_pattern_tr",
          "regex": "\\b[A-Z]{2}[0-9]{2}(?:[ ]?[0-9a-zA-Z]{4}){3,7}\\b",
          "score": 0.85
        }
      ]
    }
  ]
}